{
  "manifest_version": 3,
  "name": "Graph Explorer JSON Query",
  "version": "0.24.0",
  "description": "Adds JMESPath, JSONPath, and jq query capabilities to Microsoft Graph Explorer results: filter, reshape, and export the JSON returned by your Graph queries.",
  "homepage_url": "https://github.com/benhaspalace/Graph-Explorer-Browser-Extension",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Graph Explorer JSON Query",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; base-uri 'none'"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "commands": {
    "open-graph-explorer": {
      "suggested_key": {
        "default": "Alt+G"
      },
      "description": "Open Graph Explorer in a new tab"
    },
    "focus-query-input": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "Open the JSON Query panel and focus the query input"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://developer.microsoft.com/*"],
      "include_globs": ["*graph-explorer*"],
      "js": ["src/query-utils.js", "src/interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://developer.microsoft.com/*"],
      "include_globs": ["*graph-explorer*"],
      "js": ["vendor/jmespath.js", "vendor/jsonpath-plus.js", "vendor/jq-wasm.js", "vendor/codemirror.js", "src/query-utils.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/content.css", "src/evaluator.html"],
      "matches": ["https://developer.microsoft.com/*"]
    }
  ]
}
